<Window x:Class="Homade.Views.MainWindow"
        Style="{StaticResource MaterialDesignWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Homade"
        mc:Ignorable="d"
        Title="Homade" Height="450" Width="800">
    
    <DockPanel>
        <!-- MENU BAR -->
        <Menu DockPanel.Dock="Left" Style="{StaticResource MaterialDesignMenu}" VerticalAlignment="Top">
            <MenuItem Click="HomeMenu_Click" Style="{StaticResource MaterialDesignMenuItem}">
                <MenuItem.Header>
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="Home" HorizontalAlignment="Center"/>
                        <TextBlock Text="Home"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Click="NotesMenu_Click" Style="{StaticResource MaterialDesignMenuItem}">
                <MenuItem.Header>
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="NoteText" HorizontalAlignment="Center"/>
                        <TextBlock Text="Notes" HorizontalAlignment="Center"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </Menu>

        <!-- NAVIGATION FRAME -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
