<Page x:Class="Homade.Views.Note.AddNotePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Homade.Views.Note"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:input="clr-namespace:Homade.Views.Components.Input"
      mc:Ignorable="d"
      Title="AddNotePage" Height="450" Width="800">
    
    <Grid>
        <materialDesign:Card Padding="24"
                             UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid RowDefinitions="Auto, * , Auto">

                <!-- NOTE TITLE -->
                <TextBox x:Name="TitleBox"
                         Grid.Row="0"
                         materialDesign:HintAssist.Hint="Note Title"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         FontSize="16"
                         Margin="0 0 0 20"/>

                <!-- WYSIWYG EDITOR -->
                <input:RichTextEditor x:Name="NoteEditor" Grid.Row="1"/>

                <!-- SAVE BUTTON -->
                <Button Content="Save Note"
                        Width="140"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin="0 20 0 0"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="SaveNote_Click"/>
            </Grid>
        </materialDesign:Card>
    </Grid> 
</Page>
